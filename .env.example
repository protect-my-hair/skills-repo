# Required by Auth.js. Use a real secret in deployed environments.
AUTH_SECRET=

# Enables Prisma/PostgreSQL persistence. Leave empty for local JSON fallback.
DATABASE_URL=

# Internal credential bootstrap provider. Production requires explicit true.
SKILLS_REPO_ENABLE_INTERNAL_AUTH=true

# Optional local seed credentials. Use non-production values only in local dev.
SKILLS_REPO_SEED_ADMIN_PASSWORD=
SKILLS_REPO_SEED_EMPLOYEE_PASSWORD=
